{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build --workspace @multicam/dashboard",
  "outputDirectory": "apps/dashboard/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://multiscreen-imxo.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://multiscreen-imxo.onrender.com/auth/:path*"
    },
    {
      "source": "/health",
      "destination": "https://multiscreen-imxo.onrender.com/health"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}